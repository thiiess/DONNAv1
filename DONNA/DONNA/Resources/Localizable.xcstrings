    "Den kostenlosen API-Schlüssel erhältst du unter aistudio.google.com. Er wird ausschließlich sicher im Keychain des Geräts gespeichert – niemals in der App oder in der Cloud." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kostenlosen API-Schlüssel erhältst du unter aistudio.google.com. Er wird ausschließlich sicher im Keychain des Geräts gespeichert – niemals in der App oder in der Cloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
